ریافت رسید", "چاپ صفحه", "ذخیره اطلاعات", "اشتراک‌گذاری", "مشاهده سوابق", "پرداخت آنلاین", "دریافت لینک", "ارسال درخواست", "پشتیبانی", "مشاهده راهنما", "بررسی وضعیت", "دریافت کد رهگیری", "تأیید اطلاعات", "احراز هویت در صورت نیاز", "مدیریت حساب", "دانلود گزارش", "خروج از حساب"], "description": "Speedtest یکی از سایت‌های کاربردی در دسته «ابزار آنلاین» است. از این بخش می‌توانید سریع وارد سامانه شوید و خدمات در دسترس آن را بررسی و انجام دهید. توجه: خدمات و گزینه‌های فعال هر سامانه ممکن است تغییر کند."}]; let sites=JSON.parse(localStorage.getItem("spin_sites")||"null")||DEFAULT;
let fav=new Set(JSON.parse(localStorage.getItem("spin_fav")||"[]"));
let active="همه",onlyFav=false,admin=localStorage.getItem("spin_admin")==="1";
const $=x=>document.getElementById(x);
const esc=x=>String(x).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
const enc=x=>encodeURIComponent(x);
const dec=x=>decodeURIComponent(x);
function save(){localStorage.setItem("spin_sites",JSON.stringify(sites));localStorage.setItem("spin_fav",JSON.stringify([...fav]));}
function msg(x){$("toast").textContent=x;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1800)}
function cats(){return ["همه",...new Set(sites.map(x=>x.cat))]}
function render(){
let cs=cats();$("tabs").innerHTML=cs.map(c=>`<button class="btn tab ${c===active?"primary":""}" data-c="${enc(c)}">${esc(c)}</button>`).join("");
$("nc").innerHTML=cs.filter(x=>x!=="همه").map(x=>`<option>${esc(x)}</option>`).join("");
let q=$("search").value.toLowerCase().trim();
let list=sites.filter(s=>(active==="همه"||s.cat===active)&&(!onlyFav||fav.has(s.name))&&(s.name+" "+s.cat).toLowerCase().includes(q));
$("count").textContent=sites.length;$("fc").textContent=fav.size;$("cc").textContent=cs.length-1;
$("grid").innerHTML=list.length?list.map(s=>`<article class="card"><div><div class="cardtop"><span class="icon">${s.icon||"🌐"}</span><span class="cat">${esc(s.cat)}</span></div><h3>${esc(s.name)}</h3></div><div class="row"><a class="btn primary" href="${esc(s.url)}" target="_blank" rel="noopener">ورود ↗</a><button class="btn star" data-f="${enc(s.name)}">${fav.has(s.name)?"★":"☆"}</button><button class="btn" data-info="${enc(s.name)}">ℹ️</button>${admin?`<button class="btn" data-d="${enc(s.name)}">🗑️</button>`:""}</div></article>`).join(""):'<div class="empty">🔎 نتیجه‌ای پیدا نشد.</div>';
$("admin").classList.toggle("show",admin);$("login").style.display=admin?"none":"inline-block";$("logout").style.display=admin?"inline-block":"none";
}
$("search").oninput=render;
$("tabs").onclick=e=>{let b=e.target.closest("[data-c]");if(b){active=dec(b.dataset.c);onlyFav=false;render()}};
$("grid").onclick=e=>{let info=e.target.closest("[data-info]"); if(info){let n=dec(info.dataset.info),s=sites.find(x=>x.name===n);if(s){$("infoTitle").textContent=s.icon+" "+s.name;$("infoDesc").textContent=s.description;$("taskList").innerHTML=s.tasks.map(x=>"<li>"+esc(x)+"</li>").join("");$("infoModal").classList.add("show")}return} let f=e.target.closest("[data-f]"),d=e.target.closest("[data-d]");if(f){let n=dec(f.dataset.f);fav.has(n)?fav.delete(n):fav.add(n);save();render()}if(d){let n=dec(d.dataset.d);if(confirm("این سایت حذف شود؟")){sites=sites.filter(s=>s.name!==n);fav.delete(n);save();render();msg("حذف شد")}}};
$("favfilter").onclick=()=>{onlyFav=!onlyFav;$("favfilter").textContent=onlyFav?"📋 همه سایت‌ها":"⭐ محبوب‌ها";render()};
$("closeInfo").onclick=()=>$("infoModal").classList.remove("show"); $("infoModal").onclick=e=>{if(e.target.id==="infoModal")$("infoModal").classList.remove("show")};
$("add").onclick=()=>{let n=$("nn").value.trim(),u=$("nu").value.trim(),c=$("nc").value;if(!n||!u)return msg("نام و لینک را وارد کن");if(!/^https?:\/\//i.test(u))u="https://"+u;sites.push({name:n,url:u,cat:c,icon:"🌐"});save();$("nn").value="";$("nu").value="";render();msg("سایت اضافه شد ✅")};
$("login").onclick=()=>{$("modal").classList.add("show");$("user").focus()};$("close").onclick=()=>$("modal").classList.remove("show");
$("doLogin").onclick=()=>{if($("user").value==="admin"&&$("pass").value==="1234"){admin=true;localStorage.setItem("spin_admin","1");$("modal").classList.remove("show");render();msg("ورود موفق ✅")}else msg("اطلاعات ورود اشتباه است")};
$("logout").onclick=()=>{admin=false;localStorage.removeItem("spin_admin");render();msg("خارج شدی")};
$("theme").onclick=()=>{document.body.classList.toggle("dark");let d=document.body.classList.contains("dark");localStorage.setItem("spin_theme",d?"dark":"light");$("theme").textContent=d?"☀️":"🌙"};
if(localStorage.getItem("spin_theme")==="dark"){$("theme").textContent="☀️";document.body.classList.add("dark")}
render();
</script></body></html>
